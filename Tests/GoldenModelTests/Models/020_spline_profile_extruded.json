      "params": {
        "plane": "front"
      }
    },
    {
      "command": "sketch.add_spline",
      "params": {
        "poles": [
          [
            30,
            0
          ],
          [
            30,
            20
          ],
          [
            0,
            20
          ],
          [
            0,
            0
          ]
        ]
      }
    },
    {
      "command": "sketch.add_line",
      "params": {
        "start": [
