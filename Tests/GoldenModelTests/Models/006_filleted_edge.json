{
  "forge_script": 1,
  "name": "006_filleted_edge",
  "description": "10 mm cube with one edge filleted at radius 2",
  "commands": [
    {
      "command": "document.new",
      "params": {}
    },
    {
      "command": "body.create_box",
      "params": {
        "width": 10,
        "height": 10,
        "depth": 10
      }
    },
    {
      "command": "body.fillet_edges",
      "params": {
        "body": "body-1",
        "edges": [
          "body-1/edge-0"
        ],
        "radius": 2
      }
    }
  ],
  "expect": {
    "bodies": [
      {
        "body": "body-1",
        "volume_mm3": {
          "value": 991.4159265358979,
          "tol": 1e-06
        },
        "surface_area_mm2": {
          "value": 589.6991118430775,
          "tol": 1e-06
        },
        "faces": 7,
        "edges": 15,
        "vertices": 10,
        "valid": true,
        "closed": true
      }
    ]
  }
}
